/*
  # --- Security & privacy ---
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=()
  Cross-Origin-Opener-Policy: same-origin

  # --- Content Security Policy (single, consolidated) ---
  # Notes:
  # - Allows inline CSS/JS for now ('unsafe-inline'); remove later when you extract to files or use nonces.
  # - Allows images from your domain, Cloudflare Images, and data: URIs.
  # - Blocks plugins/objects and cross-site framing.
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests; img-src 'self' https://imagedelivery.net data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self' data:;
